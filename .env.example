# Copy to .env for local runs (scripts/sync-shelterluv-csv.js) and set the same
# keys in Netlify's site environment variables for deployed functions.

# Existing
SHELTERLUV_API_KEY=
GIVEBUTTER_API_KEY=

# Needed for netlify/functions/sync-shopify-contacts.js
# From the Dev Dashboard app's Settings page (Client credentials).
# SHOPIFY_SHOP is just the subdomain, e.g. "loves-legacy-rescue" (no .myshopify.com).
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Needed for netlify/functions/sync-squarespace-contacts.js
# Connect the Squarespace form's "Storage" tab to a Google Sheet, then in that
# Sheet: File > Share > Publish to web > select the sheet/tab > CSV > Publish.
# Paste the resulting URL here (note: anyone with this exact link can view it).
SQUARESPACE_SHEET_CSV_URL=
